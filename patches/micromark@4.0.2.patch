+      if (end !== index + 2) event[1].end = events[end - 1][1].end
+      events[write++] = event
+      if (index + 1 < length) events[write++] = events[index + 1]
+      index = end
     }
 
+    events.length = write
+
     return extraResolver ? extraResolver(events, context) : events
   }
