+    while (index < length) {
+      const event = events[index]
+
+      if (event[1].type !== types.data) {
+        events[write++] = event
+        index++
+        continue
       }
+
+      // The enter's own exit is at `index + 1`; a run continues from there.
+      let end = index + 2
+      while (end < length && events[end][1].type === types.data) end++
